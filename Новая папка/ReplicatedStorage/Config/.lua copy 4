-- Сколько монет даётся за матч в зависимости от kills/time/level.
function Progression.matchReward(stats): number
	return math.floor((stats.kills or 0) * 0.5 + (stats.time or 0) * 0.05 + (stats.level or 1) * 5)
end

return Progression

